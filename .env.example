# Copy to .env (or export) — every value is validated at boot; invalid values stop the server.
NODE_ENV=development
HOST=0.0.0.0
PORT=3007
# Defaults to ./data/localeguard.sqlite; use /data/localeguard.sqlite in containers.
DATABASE_PATH=
LOG_LEVEL=info
# Seed the "Orbit Workspace" demo project into an empty database.
SEED_DEMO=true
# Set to true behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false
BODY_LIMIT_BYTES=819200
# Write requests (POST/PUT) allowed per client per window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
SHUTDOWN_TIMEOUT_MS=10000
